{
  "name": "mcp-evidence-gate",
  "version": "0.1.0-alpha.3",
  "private": true,
  "files": ["dist", "action.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "description": "Experimental downstream verifier and CI policy gate for evidence-scoped MCP security scan receipts.",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "bin": {
    "mcp-evidence-gate": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/bundle-action.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci-hygiene": "node --test scripts/check-action-pins.node-tests.mjs",
    "test:profile-drift": "node --test scripts/profile-drift-sentinel.node-tests.mjs",
    "check:profile-drift": "node scripts/profile-drift-sentinel.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.19.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@actions/core": "1.11.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
